# =============================================================================
#  Copy this file to  .env  and fill in your real values.
#     cp .env.example .env
# =============================================================================

# --- YouTrack ---------------------------------------------------------------
# Pick a version tag from https://hub.docker.com/r/jetbrains/youtrack/tags
YOUTRACK_VERSION=2025.1.68016

# Fully-qualified hostname YouTrack will be served on.
# For HTTP-01 this MUST resolve (A/AAAA record) to THIS server's public IP,
# and port 80 must be reachable from the internet.
YOUTRACK_DOMAIN=youtrack.example.com
