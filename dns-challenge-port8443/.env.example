# =============================================================================
#  Copy this file to  .env  and fill in your real values.
#     cp .env.example .env
# =============================================================================

# --- YouTrack ---------------------------------------------------------------
# Pick a version tag from https://hub.docker.com/r/jetbrains/youtrack/tags
YOUTRACK_VERSION=2026.2.17765
#
# NOTE: your public hostname is NOT set here. Set it in dynamic/youtrack.yml
#       (the router `rule` line).
#
# IMPORTANT for this :8443 variant — the YouTrack base-url MUST include the port:
#       https://youtrack.example.com:8443
# Set it once with (adjust the hostname):
#   docker compose run --rm --no-deps youtrack \
#       configure --base-url=https://youtrack.example.com:8443

# --- Namecheap API (DNS-01 challenge) ---------------------------------------
# Enable API access first:  Namecheap dashboard > Profile > Tools > API Access.
# Eligibility (one of): $50 account balance, 20+ domains, or $50 spent in 2 yrs.
# Then WHITELIST this server's public IPv4 in the same API Access screen.
NAMECHEAP_API_USER=your_namecheap_username
NAMECHEAP_API_KEY=your_namecheap_api_key

# Optional lego tuning (safe to leave as-is):
NAMECHEAP_PROPAGATION_TIMEOUT=3600
NAMECHEAP_POLLING_INTERVAL=15
NAMECHEAP_TTL=120
